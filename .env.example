# GridWise Environment Configuration

# Service Host & Port
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini Configuration
# Paste your Gemini API key below (e.g. AIzaSy...)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_SECONDS=15.0

# Alternatively, standard OpenAI-compatible key:
LLM_API_KEY=

# Optional secondary tie-break penalty weight on peak grid import
PEAK_PENALTY_WEIGHT=0.0001
